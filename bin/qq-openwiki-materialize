#!/usr/bin/env bash
set -euo pipefail

if (( $# != 2 )); then
  echo "usage: qq-openwiki-materialize freeze|thaw REPOSITORY" >&2
  exit 2
fi

action="$1"
root="$(git -C "$2" rev-parse --show-toplevel)"
generated="$root/openwiki"

case "$action" in freeze|thaw) ;; *) echo "OpenWiki materialization action must be freeze or thaw." >&2; exit 2 ;; esac
if [[ ! -e "$generated" && ! -L "$generated" ]]; then exit 0; fi
if [[ ! -d "$generated" || -L "$generated" ]]; then
  echo "OpenWiki materialization is not a regular directory: $generated" >&2
  exit 1
fi
if find "$generated" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
  echo "OpenWiki materialization contains a non-file entry." >&2
  exit 1
fi

if [[ "$action" == thaw ]]; then
  find "$generated" -type d -exec chmod 0755 -- {} +
  find "$generated" -type f -exec chmod 0644 -- {} +
else
  find "$generated" -type f -exec chmod 0444 -- {} +
  find "$generated" -depth -type d -exec chmod 0555 -- {} +
fi
