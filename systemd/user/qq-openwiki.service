[Unit]
Description=Refresh qq OpenWiki on main and registered legacy OpenWikis

[Service]
Type=oneshot
TimeoutStartSec=6h
WorkingDirectory=%h/projects/qq-core
UMask=0077
Environment=QQ_OPENWIKI_PUBLISHED_REPO_KEY=qq
Environment="PATH=%h/.local/bin:%h/.bun/bin:%h/.opencode/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=%h/projects/qq-core/bin/qq-openwiki-service
